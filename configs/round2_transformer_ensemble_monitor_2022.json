{
  "validation_start": "2022-01-01",
  "use_extended": true,
  "use_system_context": true,
  "use_topology": true,
  "stable_scaling": true,
  "use_economic_rescaling": true,
  "model_type": "transformer",
  "seed": 42,
  "epochs": 40,
  "patience": 8,
  "batch_size": 32,
  "learning_rate": 0.001,
  "early_stopping_metric": "ensemble",
  "model": {
    "width": 64,
    "heads": 4,
    "layers": 4,
    "feedforward": 128,
    "dropout": 0.1
  },
  "ensemble_monitor": {
    "tree_prediction_paths": [
      "data/processed/goal_xgboost_rescaled_2022_validation_predictions.csv",
      "data/processed/goal_lightgbm_rescaled_2022_validation_predictions.csv"
    ],
    "transformer_weights": {
      "Hogga": 0.3,
      "Tokke": 0.9,
      "Lio": 0.3,
      "Byrte": 0.0,
      "Vinje": 0.5,
      "Songa": 0.0,
      "Kjela": 0.2,
      "Vesle Kjela": 0.0,
      "Haukeli": 0.0
    },
    "reference_config": "configs/goal_submission_rescaled_tree_mean.json"
  },
  "device": "cpu"
}
