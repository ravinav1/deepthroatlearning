# Datasett og avledede data; behold mappestrukturen.
/data/**
!/data/**/
!/data/**/.gitkeep

# Lagrede modeller og checkpoints.
/models/**
!/models/**/
!/models/**/.gitkeep

# Genererte innsendingsfiler.
/submissions/**
!/submissions/**/
!/submissions/**/.gitkeep

# Virtuelle miljøer.
.venv/
venv/
env/
venvs/
.env/
.env
.env.*
!.env.example
.tox/
.nox/

# Notebook-checkpoints og Python-cache.
.ipynb_checkpoints/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated console logs; retain structured experiment reports.
/reports/*.log

# Lokale OS-filer.
.DS_Store

# Portable hydraulic experiment environments and local artifact restore state.
.venv*/
artifacts/
.cache/
.kaggle/
*.key
